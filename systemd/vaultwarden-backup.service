[Unit]
Description=Pull and verify a Vaultwarden backup from the VPS
Documentation=https://github.com/Kernyx/vaultwarden-restore-drill
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=vwbackup
Group=vwbackup
EnvironmentFile=/etc/vaultwarden-backup/backup.env
ExecStart=/usr/local/lib/vaultwarden-backup/backup.sh
# /var/lib/vaultwarden-backup, owned by vwbackup; passed as $STATE_DIRECTORY
StateDirectory=vaultwarden-backup
StateDirectoryMode=0700
# Password vault backups: readable by vwbackup only
UMask=0077
# Sandbox: read-only system, no /home, private /tmp, no privilege escalation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

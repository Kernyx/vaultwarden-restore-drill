# Copy to /etc/vaultwarden-backup/telegram.env on the Pi (owner root:root, mode 0600).
# The real file is not in git: the bot token is a secret.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your chat with the bot (docs/install.md shows how to get it)
TELEGRAM_CHAT_ID=
# Telegram API is blocked from the Pi's network, so requests go through a
# local SOCKS proxy. socks5h: the proxy resolves DNS too. Empty = direct.
TELEGRAM_PROXY=socks5h://127.0.0.1:10808
